DATABASE_URL="postgresql://user:password@localhost:5432/d2d_blitz"
AUTH_SECRET="your-secret-here"
# Local dev: http://localhost:3000
# Vercel preview: set to https://$VERCEL_URL in the Vercel dashboard (Vercel expands it automatically)
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# AI install-report parsing (src/lib/ai). Required for /dashboard/installs/upload.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model. Defaults to claude-opus-4-8.
# For cheaper high-volume parsing: claude-sonnet-4-6 or claude-haiku-4-5.
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Optional residential proxy for high-volume gokinetic checks.
# IP Royal format is usually: http://username:password@host:port
# KINETIC_PROXY_URL is the internal name; IPROYAL_PROXY_URL is an alias.
KINETIC_PROXY_URL=""
IPROYAL_PROXY_URL=""

# Twilio SMS (Fiber Blitz OS — invites + onboarding). Leave unset to run push-only.
# US business texting requires A2P 10DLC brand + campaign registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred: a Messaging Service (MG…) tied to the 10DLC campaign + number pool.
TWILIO_MESSAGING_SERVICE_SID=
# Or a single sender number (E.164), used only if no Messaging Service is set.
TWILIO_FROM=

# Sentry error monitoring
# Get your DSN from https://sentry.io -> Project Settings -> Client Keys
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="development"
APP_ENV="development"
# CI/CD only — not needed for local dev
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="d2d-blitz-web"
# SENTRY_AUTH_TOKEN="your-auth-token"

# PostHog analytics (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY="phx_your_posthog_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Email (Resend — https://resend.com)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="D2D Blitz <noreply@yourdomain.com>"

# Vercel Cron authentication — must match the CRON_SECRET set in Vercel project settings.
# Generate with: openssl rand -hex 32
# Leave empty in local dev (cron routes won't be invoked locally).
CRON_SECRET=""

# Stripe Connect (https://dashboard.stripe.com/apikeys)
# Use test keys (sk_test_… / pk_test_…) in dev; swap to live keys at launch.
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
# Signing secret from `stripe listen` or the dashboard webhook endpoint (whsec_…)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
# App origin used to build Stripe onboarding return/refresh URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
