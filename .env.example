DATABASE_URL="postgresql://user:password@localhost:5432/d2d_blitz"
AUTH_SECRET="your-secret-here"
# Local dev: http://localhost:3000
# Vercel preview: set to https://$VERCEL_URL in the Vercel dashboard (Vercel expands it automatically)
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Cron job protection secret — must match X-Cron-Secret header sent by scheduler
CRON_SECRET="your-cron-secret-here"

# Sentry error monitoring
# Get your DSN from https://sentry.io -> Project Settings -> Client Keys
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="development"
APP_ENV="development"
# CI/CD only — not needed for local dev
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="d2d-blitz-web"
# SENTRY_AUTH_TOKEN="your-auth-token"

# PostHog analytics (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY="phx_your_posthog_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Email (Resend — https://resend.com)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="D2D Blitz <noreply@yourdomain.com>"

# Vercel Cron authentication — must match the CRON_SECRET set in Vercel project settings.
# Generate with: openssl rand -hex 32
# Leave empty in local dev (cron routes won't be invoked locally).
CRON_SECRET=""

# Stripe Connect (https://dashboard.stripe.com/apikeys)
# Use test keys (sk_test_… / pk_test_…) in dev; swap to live keys at launch.
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
# Signing secret from `stripe listen` or the dashboard webhook endpoint (whsec_…)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
# App origin used to build Stripe onboarding return/refresh URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
