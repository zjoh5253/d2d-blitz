DATABASE_URL="postgresql://user:password@localhost:5432/b2b_blitz"
AUTH_SECRET="your-secret-here"
# Local dev: http://localhost:3000
# Vercel preview: set to https://$VERCEL_URL in the Vercel dashboard (Vercel expands it automatically)
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Sentry error monitoring
# Get your DSN from https://sentry.io -> Project Settings -> Client Keys
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="development"
APP_ENV="development"
# CI/CD only — not needed for local dev
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="d2d-blitz-web"
# SENTRY_AUTH_TOKEN="your-auth-token"

# Email (Resend — https://resend.com)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="D2D Blitz <noreply@yourdomain.com>"
