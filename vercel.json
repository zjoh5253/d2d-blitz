{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/payout-batch",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/payout-sla-check",
      "schedule": "0 * * * *"
    }
  ]
}
