{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/suppress", "schedule": "0 9 * * *" },
    { "path": "/api/cron/precreate-scan", "schedule": "0 10 * * *" },
    { "path": "/api/cron/gate-sweep", "schedule": "*/5 * * * *" }
  ]
}
