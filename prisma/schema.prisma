generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EXECUTIVE
  RECRUITER
  MARKET_OWNER
  FIELD_MANAGER
  FIELD_REP
  CALL_CENTER
}

enum LeadSource {
  COLD
  SOCIAL
  REFERRAL
  PAID
}

enum LeadStatus {
  NEW
  SCREENING
  INTERVIEW
  APPROVED
  REJECTED
  ONBOARDED
}

enum InterviewResult {
  PENDING
  APPROVED
  REJECTED
}

enum BlitzStatus {
  PLANNING
  STAFFING
  READY
  ACTIVE
  REVIEW
  CLOSED
}

enum BlitzAssignmentStatus {
  ASSIGNED
  CONFIRMED
  IN_TRANSIT
  ACTIVE
  DEPARTED
  REMOVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ExpenseCategory {
  HOUSING
  TRAVEL
  OPERATIONAL
  OTHER
}

enum GoBackStatus {
  SCHEDULED
  REVISITED
  CONVERTED
  CLOSED
}

enum SaleStatus {
  SUBMITTED
  PENDING_INSTALL
  INSTALLED
  VERIFIED
  CANCELLED
  DISPUTED
}

enum InstallRecordStatus {
  MATCHED
  UNMATCHED
  DISPUTED
}

enum CommissionStatus {
  ELIGIBLE
  PENDING
  ON_HOLD
  PAID
}

enum PayoutBatchStatus {
  DRAFT
  REVIEWED
  APPROVED
  PAID
}

enum StripeOnboardingStatus {
  NOT_STARTED
  PENDING
  ACTIVE
  RESTRICTED
}

enum TransferStatus {
  PENDING
  PAID
  FAILED
  REVERSED
}

enum DeductionCategory {
  HOUSING
  TRAVEL
  SHARED
  REP_SPECIFIC
}

enum InboundLeadStatus {
  NEW
  CONTACTED
  SUBMITTED
  INSTALLED
  VERIFIED
}

enum InboundSaleStatus {
  SUBMITTED
  PENDING_INSTALL
  INSTALLED
  VERIFIED
  CANCELLED
}

enum DoorKnockDisposition {
  PENDING
  NOT_HOME
  GO_BACK
  SOLD
  NOT_INTERESTED
}

enum TouchpointOutcome {
  NO_ANSWER
  NOT_INTERESTED
  CALLBACK
  PITCHED
  SOLD
  DO_NOT_KNOCK
}

enum TouchpointType {
  DOOR_KNOCK
  CONTACT
  CONVERSATION
  DEMO
  CLOSE
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
}

enum MarketStatus {
  ACTIVE
  INACTIVE
  PLANNING
}

enum AgreementType {
  REP_AGREEMENT
  GPS_CONSENT
  TAX_W9
  BACKGROUND_CHECK
}

// ─── NextAuth Models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model GovernanceTier {
  id                   String   @id @default(cuid())
  name                 String
  rank                 Int
  minInstallRate       Float    @map("min_install_rate")
  commissionMultiplier Float    @default(1.0) @map("commission_multiplier")
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at")

  users             User[]
  governancePeriods GovernancePeriod[]
  commissionRecords CommissionRecord[]

  @@map("governance_tiers")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?   @map("password_hash")
  name             String?
  phone            String?
  role             Role
  status           UserStatus @default(ACTIVE)
  governanceTierId String?   @map("governance_tier_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Email verification
  emailVerified             Boolean   @default(false) @map("email_verified")
  emailVerificationToken    String?   @unique @map("email_verification_token")
  emailVerificationExpires  DateTime? @map("email_verification_expires")

  // Password reset
  passwordResetToken        String?   @unique @map("password_reset_token")
  passwordResetExpires      DateTime? @map("password_reset_expires")

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // GovernanceTier relation
  governanceTier GovernanceTier? @relation(fields: [governanceTierId], references: [id])

  // Recruiter side of leads
  recruitedLeads Lead[] @relation("RecruiterLeads")

  // Field manager side of leads
  managedLeads Lead[] @relation("FieldManagerLeads")

  // Leads where this user was created via onboarding
  onboardedLeads Lead[] @relation("OnboardedLeads")

  // Interviews conducted
  interviews Interview[]

  // Markets owned
  ownedMarkets Market[]

  // Blitzes managed
  managedBlitzes Blitz[]

  // Blitz assignments (as rep)
  blitzAssignments BlitzAssignment[]

  // Daily reports
  dailyReports DailyReport[]

  // Go-backs recorded
  goBacksRecorded GoBack[]

  // Sales made
  sales Sale[]

  // Install uploads
  installUploads InstallUpload[]

  // Exceptions resolved
  resolvedExceptions InstallException[] @relation("ExceptionResolver")

  // Commission records
  commissionRecords CommissionRecord[]

  // Deductions
  deductions Deduction[]

  // Payout lines
  payoutLines PayoutLine[]

  // Approved payout batches
  approvedBatches PayoutBatch[]

  // Payout batch audit logs
  payoutBatchAuditLogs PayoutBatchAuditLog[]

  // Governance periods
  governancePeriods GovernancePeriod[]

  // Compliance holds
  complianceHolds ComplianceHold[] @relation("RepComplianceHolds")

  // Compliance holds restored by this user
  restoredComplianceHolds ComplianceHold[] @relation("ComplianceHoldRestorer")

  // Door knock leads assigned to this rep
  doorKnockLeads DoorKnockLead[] @relation("AssignedDoorKnockLeads")

  // Door knock leads uploaded by this user
  uploadedDoorKnockLeads DoorKnockLead[] @relation("UploadedDoorKnockLeads")

  // Inbound contact attempts (as agent)
  inboundContactAttempts InboundContactAttempt[]

  // Inbound sales (as agent)
  inboundSalesAsAgent InboundSale[] @relation("InboundSaleAgent")

  // Inbound sales (as affiliate)
  inboundSalesAsAffiliate InboundSale[] @relation("InboundSaleAffiliate")

  // Push notification tokens
  devicePushTokens DevicePushToken[]

  // Touchpoints logged by this rep
  touchpoints Touchpoint[]

  // Onboarding agreement acceptances
  agreementAcceptances AgreementAcceptance[]

  // GPS tracking sessions uploaded from the mobile app
  gpsSessions GpsSession[]

  // Stripe Connect payout account (1:1)
  stripeAccount StripeConnectedAccount?

  // Stripe payout transfers received
  payoutTransfers PayoutTransfer[]

  @@index([role])
  @@index([status])
  @@index([governanceTierId])
  @@map("users")
}

model Lead {
  id               String     @id @default(cuid())
  name             String
  phone            String
  email            String?
  source           LeadSource
  status           LeadStatus @default(NEW)
  recruiterId      String     @map("recruiter_id")
  fieldManagerId   String?    @map("field_manager_id")
  marketId         String?    @map("market_id")
  onboardedUserId  String?    @map("onboarded_user_id")
  notes            String?
  travelCapable    Boolean    @map("travel_capable")
  commitmentLevel  String?    @map("commitment_level")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  recruiter      User    @relation("RecruiterLeads", fields: [recruiterId], references: [id])
  fieldManager   User?   @relation("FieldManagerLeads", fields: [fieldManagerId], references: [id])
  market         Market? @relation(fields: [marketId], references: [id])
  onboardedUser  User?   @relation("OnboardedLeads", fields: [onboardedUserId], references: [id])

  interviews Interview[]

  @@index([status])
  @@index([source])
  @@index([recruiterId])
  @@index([fieldManagerId])
  @@index([marketId])
  @@index([onboardedUserId])
  @@map("leads")
}

model Interview {
  id                     String          @id @default(cuid())
  leadId                 String          @map("lead_id")
  interviewerId          String          @map("interviewer_id")
  cultureFit             Int             @map("culture_fit")
  workEthic              Int             @map("work_ethic")
  travelReadiness        Int             @map("travel_readiness")
  performanceExpectations Int            @map("performance_expectations")
  notes                  String?
  result                 InterviewResult @default(PENDING)
  date                   DateTime
  createdAt              DateTime        @default(now()) @map("created_at")

  lead        Lead @relation(fields: [leadId], references: [id])
  interviewer User @relation(fields: [interviewerId], references: [id])

  @@index([leadId])
  @@index([interviewerId])
  @@index([result])
  @@map("interviews")
}

model Carrier {
  id               String        @id @default(cuid())
  name             String
  revenuePerInstall Float        @map("revenue_per_install")
  portalUrl        String?       @map("portal_url")
  status           CarrierStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")

  markets        Market[]
  stackConfigs   StackConfig[]
  sales          Sale[]
  installUploads InstallUpload[]
  installRecords InstallRecord[]
  inboundSales   InboundSale[]

  @@index([status])
  @@map("carriers")
}

model Market {
  id               String       @id @default(cuid())
  name             String
  carrierId        String       @map("carrier_id")
  ownerId          String       @map("owner_id")
  coverageArea     String?      @map("coverage_area")
  competitionNotes String?      @map("competition_notes")
  status           MarketStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")

  carrier Carrier @relation(fields: [carrierId], references: [id])
  owner   User    @relation(fields: [ownerId], references: [id])

  blitzes      Blitz[]
  leads        Lead[]
  stackConfigs StackConfig[]

  @@index([carrierId])
  @@index([ownerId])
  @@index([status])
  @@map("markets")
}

model Blitz {
  id          String      @id @default(cuid())
  marketId    String      @map("market_id")
  name        String
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  repCap      Int         @map("rep_cap")
  housingPlan String?     @map("housing_plan")
  status      BlitzStatus @default(PLANNING)
  managerId   String      @map("manager_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  market  Market @relation(fields: [marketId], references: [id])
  manager User   @relation(fields: [managerId], references: [id])

  assignments   BlitzAssignment[]
  expenses      BlitzExpense[]
  dailyReports  DailyReport[]
  goBacksRecorded GoBack[]
  sales         Sale[]
  deductions    Deduction[]
  commissionRecords CommissionRecord[]
  doorKnockLeads DoorKnockLead[]
  touchpoints    Touchpoint[]

  @@index([marketId])
  @@index([managerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("blitzes")
}

model BlitzAssignment {
  id                  String                @id @default(cuid())
  blitzId             String                @map("blitz_id")
  repId               String                @map("rep_id")
  housingAssignment   String?               @map("housing_assignment")
  travelCoordination  String?               @map("travel_coordination")
  arrivalConfirmed    Boolean               @default(false) @map("arrival_confirmed")
  status              BlitzAssignmentStatus @default(ASSIGNED)
  createdAt           DateTime              @default(now()) @map("created_at")

  blitz Blitz @relation(fields: [blitzId], references: [id])
  rep   User  @relation(fields: [repId], references: [id])

  @@index([blitzId])
  @@index([repId])
  @@index([status])
  // Partial unique index: blitz_assignments_one_active_per_rep ON (rep_id) WHERE status NOT IN ('DEPARTED','REMOVED')
  // Added via raw SQL migration (Prisma does not support partial unique indexes in schema.prisma).
  @@map("blitz_assignments")
}

model BlitzExpense {
  id          String          @id @default(cuid())
  blitzId     String          @map("blitz_id")
  category    ExpenseCategory
  amount      Float
  description String
  date        DateTime
  createdAt   DateTime        @default(now()) @map("created_at")

  blitz Blitz @relation(fields: [blitzId], references: [id])

  @@index([blitzId])
  @@index([category])
  @@index([date])
  @@map("blitz_expenses")
}

model DailyReport {
  id                   String   @id @default(cuid())
  repId                String   @map("rep_id")
  blitzId              String   @map("blitz_id")
  date                 DateTime
  doorsKnocked         Int      @map("doors_knocked")
  conversations        Int
  goBacksRecorded      Int      @map("go_backs_recorded")
  appointmentsScheduled Int     @map("appointments_scheduled")
  salesCount           Int      @map("sales_count")
  submittedAt          DateTime @default(now()) @map("submitted_at")

  rep   User  @relation(fields: [repId], references: [id])
  blitz Blitz @relation(fields: [blitzId], references: [id])

  @@unique([repId, blitzId, date])
  @@index([repId])
  @@index([blitzId])
  @@index([date])
  @@map("daily_reports")
}

model GoBack {
  id               String       @id @default(cuid())
  repId            String       @map("rep_id")
  blitzId          String       @map("blitz_id")
  prospectName     String       @map("prospect_name")
  prospectPhone    String?      @map("prospect_phone")
  prospectAddress  String       @map("prospect_address")
  status           GoBackStatus @default(SCHEDULED)
  followUpDate     DateTime     @map("follow_up_date")
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  rep   User  @relation(fields: [repId], references: [id])
  blitz Blitz @relation(fields: [blitzId], references: [id])

  doorKnockLead DoorKnockLead?

  @@index([repId])
  @@index([blitzId])
  @@index([status])
  @@index([followUpDate])
  @@map("go_backs")
}

model Sale {
  id                  String     @id @default(cuid())
  repId               String     @map("rep_id")
  blitzId             String     @map("blitz_id")
  carrierId           String     @map("carrier_id")
  customerName        String     @map("customer_name")
  customerPhone       String     @map("customer_phone")
  customerAddress     String     @map("customer_address")
  customerEmail       String?    @map("customer_email")
  installDate         DateTime   @map("install_date")
  orderConfirmation   String?    @map("order_confirmation")
  status              SaleStatus @default(SUBMITTED)
  submittedAt         DateTime   @default(now()) @map("submitted_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  rep     User    @relation(fields: [repId], references: [id])
  blitz   Blitz   @relation(fields: [blitzId], references: [id])
  carrier Carrier @relation(fields: [carrierId], references: [id])

  commissionRecord  CommissionRecord?
  matchedInstallRecord InstallRecord? @relation("MatchedSale")
  installExceptions InstallException[]

  @@index([repId])
  @@index([blitzId])
  @@index([carrierId])
  @@index([status])
  @@index([installDate])
  @@index([submittedAt])
  @@map("sales")
}

model InstallUpload {
  id             String   @id @default(cuid())
  carrierId      String   @map("carrier_id")
  uploadedById   String   @map("uploaded_by_id")
  fileName       String   @map("file_name")
  rowCount       Int      @map("row_count")
  matchedCount   Int      @default(0) @map("matched_count")
  unmatchedCount Int      @default(0) @map("unmatched_count")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  carrier    Carrier @relation(fields: [carrierId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  installRecords InstallRecord[]

  @@index([carrierId])
  @@index([uploadedById])
  @@index([uploadedAt])
  @@map("install_uploads")
}

model InstallRecord {
  id              String              @id @default(cuid())
  uploadId        String              @map("upload_id")
  carrierId       String              @map("carrier_id")
  externalId      String?             @map("external_id")
  customerName    String              @map("customer_name")
  customerAddress String              @map("customer_address")
  installDate     DateTime            @map("install_date")
  status          InstallRecordStatus @default(UNMATCHED)
  matchedSaleId   String?             @unique @map("matched_sale_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  upload      InstallUpload @relation(fields: [uploadId], references: [id])
  carrier     Carrier       @relation(fields: [carrierId], references: [id])
  matchedSale Sale?         @relation("MatchedSale", fields: [matchedSaleId], references: [id])

  exceptions InstallException[]

  @@index([uploadId])
  @@index([carrierId])
  @@index([status])
  @@index([installDate])
  @@map("install_records")
}

model InstallException {
  id              String    @id @default(cuid())
  installRecordId String    @map("install_record_id")
  saleId          String?   @map("sale_id")
  reason          String
  resolution      String?
  resolvedById    String?   @map("resolved_by_id")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  installRecord InstallRecord @relation(fields: [installRecordId], references: [id])
  sale          Sale?         @relation(fields: [saleId], references: [id])
  resolvedBy    User?         @relation("ExceptionResolver", fields: [resolvedById], references: [id])

  @@index([installRecordId])
  @@index([saleId])
  @@index([resolvedById])
  @@map("install_exceptions")
}

model StackConfig {
  id                       String   @id @default(cuid())
  carrierId                String   @map("carrier_id")
  marketId                 String?  @map("market_id")
  companyFloorPercent      Float    @map("company_floor_percent")
  managerOverridePercent   Float    @map("manager_override_percent")
  marketOwnerSpreadPercent Float    @map("market_owner_spread_percent")
  effectiveDate            DateTime @map("effective_date")
  createdAt                DateTime @default(now()) @map("created_at")

  carrier Carrier @relation(fields: [carrierId], references: [id])
  market  Market? @relation(fields: [marketId], references: [id])

  @@index([carrierId])
  @@index([marketId])
  @@index([effectiveDate])
  @@map("stack_configs")
}

model CommissionRecord {
  id                String           @id @default(cuid())
  saleId            String           @unique @map("sale_id")
  repId             String           @map("rep_id")
  blitzId           String           @map("blitz_id")
  carrierPayout     Float            @map("carrier_payout")
  companyFloor      Float            @map("company_floor")
  managerOverride   Float            @map("manager_override")
  repPay            Float            @map("rep_pay")
  marketOwnerSpread Float            @map("market_owner_spread")
  status            CommissionStatus @default(ELIGIBLE)
  governanceTierId  String?          @map("governance_tier_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  sale           Sale            @relation(fields: [saleId], references: [id])
  rep            User            @relation(fields: [repId], references: [id])
  blitz          Blitz           @relation(fields: [blitzId], references: [id])
  governanceTier GovernanceTier? @relation(fields: [governanceTierId], references: [id])

  @@index([repId])
  @@index([blitzId])
  @@index([status])
  @@index([governanceTierId])
  @@map("commission_records")
}

model Deduction {
  id          String            @id @default(cuid())
  repId       String            @map("rep_id")
  blitzId     String            @map("blitz_id")
  category    DeductionCategory
  amount      Float
  description String
  date        DateTime
  createdAt   DateTime          @default(now()) @map("created_at")

  rep   User  @relation(fields: [repId], references: [id])
  blitz Blitz @relation(fields: [blitzId], references: [id])

  @@index([repId])
  @@index([blitzId])
  @@index([category])
  @@index([date])
  @@map("deductions")
}

model PayoutBatch {
  id                String            @id @default(cuid())
  period            String            @unique
  status            PayoutBatchStatus @default(DRAFT)
  approvedById      String?           @map("approved_by_id")
  approvedAt        DateTime?         @map("approved_at")
  totalInstalls     Int               @default(0) @map("total_installs")
  matchedInstalls   Int               @default(0) @map("matched_installs")
  reconciliationRate Float            @default(0) @map("reconciliation_rate")
  slaDeadline       DateTime?         @map("sla_deadline")
  slaAlertedAt      DateTime?         @map("sla_alerted_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  approvedBy  User?                @relation(fields: [approvedById], references: [id])
  payoutLines PayoutLine[]
  auditLogs   PayoutBatchAuditLog[]

  @@index([status])
  @@index([approvedById])
  @@map("payout_batches")
}

model PayoutBatchAuditLog {
  id             String    @id @default(cuid())
  batchId        String    @map("batch_id")
  action         String
  performedById  String?   @map("performed_by_id")
  totalPayout    Float?    @map("total_payout")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  batch       PayoutBatch @relation(fields: [batchId], references: [id])
  performedBy User?       @relation(fields: [performedById], references: [id])

  @@index([batchId])
  @@index([performedById])
  @@map("payout_batch_audit_logs")
}

model PayoutLine {
  id                  String  @id @default(cuid())
  batchId             String  @map("batch_id")
  repId               String  @map("rep_id")
  grossPay            Float   @map("gross_pay")
  totalDeductions     Float   @map("total_deductions")
  netPay              Float   @map("net_pay")
  complianceVerified  Boolean @default(false) @map("compliance_verified")
  governanceChecked   Boolean @default(false) @map("governance_checked")

  batch PayoutBatch @relation(fields: [batchId], references: [id])
  rep   User        @relation(fields: [repId], references: [id])

  payoutTransfer PayoutTransfer?

  @@index([batchId])
  @@index([repId])
  @@map("payout_lines")
}

model GovernancePeriod {
  id                 String         @id @default(cuid())
  repId              String         @map("rep_id")
  month              Int
  year               Int
  submittedInstalls  Int            @map("submitted_installs")
  verifiedInstalls   Int            @map("verified_installs")
  installRate        Float          @map("install_rate")
  tierId             String         @map("tier_id")
  isStrike           Boolean        @default(false) @map("is_strike")
  consecutiveStrikes Int            @default(0) @map("consecutive_strikes")
  createdAt          DateTime       @default(now()) @map("created_at")

  rep  User           @relation(fields: [repId], references: [id])
  tier GovernanceTier @relation(fields: [tierId], references: [id])

  @@unique([repId, month, year])
  @@index([repId])
  @@index([tierId])
  @@index([year, month])
  @@map("governance_periods")
}

model ComplianceHold {
  id           String    @id @default(cuid())
  repId        String    @map("rep_id")
  reason       String
  holdDate     DateTime  @map("hold_date")
  restoredDate DateTime? @map("restored_date")
  restoredById String?   @map("restored_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  rep         User  @relation("RepComplianceHolds", fields: [repId], references: [id])
  restoredBy  User? @relation("ComplianceHoldRestorer", fields: [restoredById], references: [id])

  @@index([repId])
  @@index([restoredById])
  @@index([holdDate])
  @@map("compliance_holds")
}

model InboundLead {
  id                 String            @id @default(cuid())
  source             String
  customerName       String            @map("customer_name")
  customerPhone      String            @map("customer_phone")
  customerEmail      String?           @map("customer_email")
  status             InboundLeadStatus @default(NEW)
  qualificationNotes String?           @map("qualification_notes")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  contactAttempts InboundContactAttempt[]
  inboundSales    InboundSale[]

  @@index([status])
  @@index([source])
  @@map("inbound_leads")
}

model InboundContactAttempt {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  agentId     String   @map("agent_id")
  attemptDate DateTime @map("attempt_date")
  outcome     String
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  lead  InboundLead @relation(fields: [leadId], references: [id])
  agent User        @relation(fields: [agentId], references: [id])

  @@index([leadId])
  @@index([agentId])
  @@index([attemptDate])
  @@map("inbound_contact_attempts")
}

model InboundSale {
  id                String           @id @default(cuid())
  leadId            String           @map("lead_id")
  agentId           String           @map("agent_id")
  carrierId         String           @map("carrier_id")
  customerName      String           @map("customer_name")
  customerPhone     String           @map("customer_phone")
  customerAddress   String           @map("customer_address")
  customerEmail     String?          @map("customer_email")
  installDate       DateTime         @map("install_date")
  orderConfirmation String?          @map("order_confirmation")
  status            InboundSaleStatus @default(SUBMITTED)
  affiliateId       String?          @map("affiliate_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  lead      InboundLead @relation(fields: [leadId], references: [id])
  agent     User        @relation("InboundSaleAgent", fields: [agentId], references: [id])
  carrier   Carrier     @relation(fields: [carrierId], references: [id])
  affiliate User?       @relation("InboundSaleAffiliate", fields: [affiliateId], references: [id])

  @@index([leadId])
  @@index([agentId])
  @@index([carrierId])
  @@index([affiliateId])
  @@index([status])
  @@index([installDate])
  @@map("inbound_sales")
}

// ─── Door Knock Leads ────────────────────────────────────────────────────────

model DoorKnockLead {
  id              String               @id @default(cuid())
  firstName       String?              @map("first_name")
  lastName        String?              @map("last_name")
  streetNumber    String               @map("street_number")
  streetName      String               @map("street_name")
  city            String
  state           String
  zip             String
  disposition     DoorKnockDisposition @default(PENDING)
  notes           String?
  assignedRepId   String?              @map("assigned_rep_id")
  blitzId         String?              @map("blitz_id")
  goBackId        String?              @unique @map("go_back_id")
  uploadedById    String               @map("uploaded_by_id")
  uploadBatchId   String?              @map("upload_batch_id")
  resolvedAt      DateTime?            @map("resolved_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  assignedRep  User?   @relation("AssignedDoorKnockLeads", fields: [assignedRepId], references: [id])
  uploadedBy   User    @relation("UploadedDoorKnockLeads", fields: [uploadedById], references: [id])
  blitz        Blitz?  @relation(fields: [blitzId], references: [id])
  goBack       GoBack? @relation(fields: [goBackId], references: [id])

  @@index([assignedRepId])
  @@index([blitzId])
  @@index([disposition])
  @@index([uploadBatchId])
  @@index([uploadedById])
  @@map("door_knock_leads")
}

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_push_tokens")
}

// ─── Touchpoints ─────────────────────────────────────────────────────────────

model Touchpoint {
  id        String             @id @default(cuid())
  repId     String             @map("rep_id")
  blitzId   String             @map("blitz_id")
  type      TouchpointType     @default(DOOR_KNOCK)
  address   String             @default("")
  outcome   TouchpointOutcome  @default(NO_ANSWER)
  notes     String?
  latitude  Float?
  longitude Float?
  timestamp DateTime           @default(now())
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  rep   User  @relation(fields: [repId], references: [id])
  blitz Blitz @relation(fields: [blitzId], references: [id])

  @@index([repId])
  @@index([blitzId])
  @@index([type])
  @@index([outcome])
  @@index([timestamp])
  @@map("touchpoints")
}

// ─── Onboarding Agreements ─────────────────────────────────────────────────────

model Agreement {
  id             String        @id @default(cuid())
  type           AgreementType
  title          String
  body           String // markdown content
  version        Int           @default(1)
  required       Boolean       @default(true)
  blocking       Boolean       @default(true) // gates app access when unaccepted
  requiresUpload Boolean       @default(false) @map("requires_upload") // e.g. W-9 needs a file
  isActive       Boolean       @default(true) @map("is_active") // the current version reps must accept
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  acceptances AgreementAcceptance[]

  @@index([type])
  @@index([isActive])
  @@map("agreements")
}

model AgreementAcceptance {
  id            String   @id @default(cuid())
  agreementId   String   @map("agreement_id")
  userId        String   @map("user_id")
  version       Int
  signatureName String   @map("signature_name")
  documentUrl   String?  @map("document_url")
  acceptedAt    DateTime @default(now()) @map("accepted_at")

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agreementId])
  @@index([userId])
  @@map("agreement_acceptances")
}

// GPS tracking sessions uploaded from the mobile app (one per door-knock shift).
model GpsSession {
  id              String   @id @default(cuid())
  repId           String   @map("rep_id")
  startedAt       DateTime @map("started_at")
  endedAt         DateTime @map("ended_at")
  durationSeconds Int      @default(0) @map("duration_seconds")
  pausedSeconds   Int      @default(0) @map("paused_seconds")
  knockCount      Int      @default(0) @map("knock_count")
  routeMiles      Float    @default(0) @map("route_miles")
  createdAt       DateTime @default(now()) @map("created_at")

  rep User @relation(fields: [repId], references: [id], onDelete: Cascade)

  @@index([repId])
  @@index([startedAt])
  @@map("gps_sessions")
}

// ─── Stripe Connect payouts ─────────────────────────────────────────────────

// A rep's Stripe Connect Express account. Stripe collects bank/debit + KYC via
// hosted onboarding; we store only the account id and Stripe's capability flags.
model StripeConnectedAccount {
  id               String                 @id @default(cuid())
  userId           String                 @unique @map("user_id")
  stripeAccountId  String                 @unique @map("stripe_account_id")
  onboardingStatus StripeOnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  detailsSubmitted Boolean                @default(false) @map("details_submitted")
  chargesEnabled   Boolean                @default(false) @map("charges_enabled")
  payoutsEnabled   Boolean                @default(false) @map("payouts_enabled")
  defaultCurrency  String                 @default("usd") @map("default_currency")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeAccountId])
  @@map("stripe_connected_accounts")
}

// One row per Stripe Transfer created when a PayoutBatch is marked PAID. Links a
// domain PayoutLine to the money that actually moved. Idempotency key on create
// is the payoutLineId, so retries never double-pay a rep.
model PayoutTransfer {
  id               String         @id @default(cuid())
  payoutLineId     String         @unique @map("payout_line_id")
  repId            String         @map("rep_id")
  stripeAccountId  String         @map("stripe_account_id")
  stripeTransferId String?        @unique @map("stripe_transfer_id")
  amount           Float
  currency         String         @default("usd")
  status           TransferStatus @default(PENDING)
  failureReason    String?        @map("failure_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  payoutLine PayoutLine @relation(fields: [payoutLineId], references: [id])
  rep        User       @relation(fields: [repId], references: [id])

  @@index([repId])
  @@index([status])
  @@map("payout_transfers")
}
