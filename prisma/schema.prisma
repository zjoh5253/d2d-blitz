// ─── Door Knock Leads ────────────────────────────────────────────────────────

model DoorKnockLead {
  id              String               @id @default(cuid())
  firstName       String?              @map("first_name")
  lastName        String?              @map("last_name")
  streetNumber    String               @map("street_number")
  streetName      String               @map("street_name")
  city            String
  state           String
  zip             String
  // Geographic coordinates — required by the rep-assignment planner to
  // build walkable territory clusters. Nullable because legacy / manual /
  // CSV-imported leads may not have them.
  lat             Float?
  lng             Float?
  // Coordinate provenance. When a rep dispositions a door, their phone GPS
  // (if a good fix) overwrites lat/lng in place — the rep standing at the
  // door is the most accurate source we have. coordSource records where the
  // current lat/lng came from ("rep_gps" once verified in the field, else the
  // import source) so a later bulk re-import never clobbers a rep-verified pin.
  coordSource     String?              @map("coord_source")
  coordsUpdatedAt DateTime?            @map("coords_updated_at")
  disposition     DoorKnockDisposition @default(PENDING)
  notes           String?
  assignedRepId   String?              @map("assigned_rep_id")
  blitzId         String?              @map("blitz_id")
  // Suppression: when a lead's address matches a known current customer
  // (existing install / sale / sold lead, or — later — a carrier partner
  // export), it's flagged so reps don't waste time knocking a door that
  // already has service. Hidden from reps; still visible to admins.
  suppressed        Boolean            @default(false)
  suppressionReason String?            @map("suppression_reason")
  goBackId        String?              @unique @map("go_back_id")
  uploadedById    String               @map("uploaded_by_id")
  uploadBatchId   String?              @map("upload_batch_id")
  resolvedAt      DateTime?            @map("resolved_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  assignedRep  User?   @relation("AssignedDoorKnockLeads", fields: [assignedRepId], references: [id])
  uploadedBy   User    @relation("UploadedDoorKnockLeads", fields: [uploadedById], references: [id])
  blitz        Blitz?  @relation(fields: [blitzId], references: [id])
  goBack       GoBack? @relation(fields: [goBackId], references: [id])
  events       DoorKnockLeadEvent[]

  @@index([assignedRepId])
  @@index([blitzId])
  @@index([disposition])
  @@index([uploadBatchId])
  @@index([uploadedById])
  @@index([suppressed])
  @@map("door_knock_leads")
}

// Per-lead action history — one row per disposition action so reps can
// re-open a pin and see what was done and when.
model DoorKnockLeadEvent {
  id          String               @id @default(cuid())
  leadId      String               @map("lead_id")
  disposition DoorKnockDisposition
  note        String?
  createdById String?              @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")

  lead DoorKnockLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("door_knock_lead_events")
}

// Cached per-address result of the Kinetic (gokinetic.com) availability
// check. Keyed by canonical address (canonicalizeAddress(street)|zip5) so a
// ZIP scanned for one blitz is reused by every other — the scan worker only
// hits gokinetic for addresses with no fresh row here. `isCustomer` drives
// lead suppression (reps don't knock current customers).
model KineticAddressStatus {
  id         String  @id @default(cuid())
  addressKey String  @unique @map("address_key")

  // Normalized signals
  serviceable Boolean @default(false)
  isCustomer  Boolean @default(false)
  comingSoon  Boolean @default(false)

  // Raw signals from the API, kept so we can re-derive the above if we
  // refine which field means "current customer".
  validationResult String? @map("validation_result")
  maxQual          String? @map("max_qual")
  techType         String? @map("tech_type")
  billingStatus    String? @map("billing_status")
  estCompletionDt  String? @map("est_completion_dt")
  raw              String?

  checkedAt DateTime @default(now()) @map("checked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isCustomer])
  @@index([serviceable])
  @@index([checkedAt])
  @@map("kinetic_address_status")
}

// Authoritative current-customer addresses from a carrier/partner export
// (e.g. Teki's Chuzo customer list). Keyed by canonical address so it feeds
// the suppression engine exactly like the in-DB sources. Re-importing an
// updated export just upserts.
model ServicedAddress {
  id         String   @id @default(cuid())
  addressKey String   @unique @map("address_key")
  source     String   // e.g. "chuzo-2026-06-04"
  rawAddress String?  @map("raw_address")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([source])
  @@map("serviced_addresses")
}

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_push_tokens")
}

// ─── Touchpoints ─────────────────────────────────────────────────────────────

model Touchpoint {
  id        String             @id @default(cuid())
  repId     String             @map("rep_id")
  blitzId   String             @map("blitz_id")
  type      TouchpointType     @default(DOOR_KNOCK)
  address   String             @default("")
  outcome   TouchpointOutcome  @default(NO_ANSWER)
  notes     String?
  latitude  Float?
  longitude Float?
  timestamp DateTime           @default(now())
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  rep   User  @relation(fields: [repId], references: [id])
  blitz Blitz @relation(fields: [blitzId], references: [id])

  @@index([repId])
  @@index([blitzId])
  @@index([type])
  @@index([outcome])
  @@index([timestamp])
  @@map("touchpoints")
}

// ─── Onboarding Agreements ─────────────────────────────────────────────────────

model Agreement {
  id             String        @id @default(cuid())
  type           AgreementType
  title          String
  body           String // markdown content
  version        Int           @default(1)
  required       Boolean       @default(true)
  blocking       Boolean       @default(true) // gates app access when unaccepted
  requiresUpload Boolean       @default(false) @map("requires_upload") // e.g. W-9 needs a file
  isActive       Boolean       @default(true) @map("is_active") // the current version reps must accept
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  acceptances AgreementAcceptance[]

  @@index([type])
  @@index([isActive])
  @@map("agreements")
}

model AgreementAcceptance {
  id            String   @id @default(cuid())
  agreementId   String   @map("agreement_id")
  userId        String   @map("user_id")
  version       Int
  signatureName String   @map("signature_name")
  documentUrl   String?  @map("document_url")
  acceptedAt    DateTime @default(now()) @map("accepted_at")

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agreementId])
  @@index([userId])
  @@map("agreement_acceptances")
}

// ─── Stripe Connect payouts ─────────────────────────────────────────────────

// A rep's Stripe Connect Express account. Stripe collects bank/debit + KYC via
// hosted onboarding; we store only the account id and Stripe's capability flags.
model StripeConnectedAccount {
  id               String                 @id @default(cuid())
  userId           String                 @unique @map("user_id")
  stripeAccountId  String                 @unique @map("stripe_account_id")
  onboardingStatus StripeOnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  detailsSubmitted Boolean                @default(false) @map("details_submitted")
  chargesEnabled   Boolean                @default(false) @map("charges_enabled")
  payoutsEnabled   Boolean                @default(false) @map("payouts_enabled")
  payoutMethod     PayoutMethod           @default(STANDARD) @map("payout_method")
  defaultCurrency  String                 @default("usd") @map("default_currency")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeAccountId])
  @@map("stripe_connected_accounts")
}

// One row per Stripe Transfer created when a PayoutBatch is marked PAID. Links a
// domain PayoutLine to the money that actually moved. Idempotency key on create
// is the payoutLineId, so retries never double-pay a rep.
model PayoutTransfer {
  id               String         @id @default(cuid())
  payoutLineId     String         @unique @map("payout_line_id")
  repId            String         @map("rep_id")
  stripeAccountId  String         @map("stripe_account_id")
  stripeTransferId String?        @unique @map("stripe_transfer_id")
  amount           Float
  currency         String         @default("usd")
  status           TransferStatus @default(PENDING)
  method           PayoutMethod   @default(STANDARD)
  instantFee       Float?         @map("instant_fee")
  stripePayoutId   String?        @unique @map("stripe_payout_id")
  failureReason    String?        @map("failure_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  payoutLine PayoutLine @relation(fields: [payoutLineId], references: [id])
  rep        User       @relation(fields: [repId], references: [id])

  @@index([repId])
  @@index([status])
  @@map("payout_transfers")
}

// ─── Holdback / retention-bonus + chargeback ────────────────────────────────

// Configurable holdback rule. A row with a null carrierId is the global default;
// a carrier-specific row overrides it. Historical commissions keep whatever rule
// resolved when they were created. (A product dimension slots in here later.)
model HoldbackPolicy {
  id              String   @id @default(cuid())
  carrierId       String?  @map("carrier_id")
  holdbackPercent Float    @map("holdback_percent")
  holdbackDays    Int      @map("holdback_days")
  effectiveDate   DateTime @map("effective_date")
  createdAt       DateTime @default(now()) @map("created_at")

  carrier Carrier? @relation(fields: [carrierId], references: [id])

  @@index([carrierId])
  @@index([effectiveDate])
  @@map("holdback_policies")
}

// The reserved slice of a rep commission, held for the retention period. Source
// of truth for held funds. Released to a payout batch as a "retention bonus" if
// the install survives; clawed back if a chargeback lands first.
model Holdback {
  id                 String         @id @default(cuid())
  commissionRecordId String         @unique @map("commission_record_id")
  repId              String         @map("rep_id")
  carrierId          String         @map("carrier_id")
  amount             Float
  percent            Float
  releaseAt          DateTime       @map("release_at")
  status             HoldbackStatus @default(HELD)
  releasedAt         DateTime?      @map("released_at")
  payoutBatchId      String?        @map("payout_batch_id")
  chargebackId       String?        @map("chargeback_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  commissionRecord CommissionRecord @relation(fields: [commissionRecordId], references: [id])
  rep              User             @relation(fields: [repId], references: [id])
  carrier          Carrier          @relation(fields: [carrierId], references: [id])
  payoutBatch      PayoutBatch?     @relation(fields: [payoutBatchId], references: [id])
  chargeback       Chargeback?      @relation(fields: [chargebackId], references: [id])

  @@index([repId])
  @@index([carrierId])
  @@index([status])
  @@index([releaseAt])
  @@index([payoutBatchId])
  @@map("holdbacks")
}

// Permanent audit record of a carrier chargeback. Held funds are applied first;
// any shortfall is recorded as outstandingBalance (no automatic deduction).
model Chargeback {
  id                 String           @id @default(cuid())
  saleId             String           @unique @map("sale_id")
  commissionRecordId String?          @unique @map("commission_record_id")
  repId              String           @map("rep_id")
  carrierId          String           @map("carrier_id")
  amount             Float
  heldApplied        Float            @default(0) @map("held_applied")
  outstandingBalance Float            @default(0) @map("outstanding_balance")
  status             ChargebackStatus @default(OPEN)
  reason             String
  createdById        String?          @map("created_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")

  sale             Sale              @relation(fields: [saleId], references: [id])
  commissionRecord CommissionRecord? @relation(fields: [commissionRecordId], references: [id])
  rep              User              @relation("RepChargebacks", fields: [repId], references: [id])
  carrier          Carrier           @relation(fields: [carrierId], references: [id])
  createdBy        User?             @relation("ChargebackCreator", fields: [createdById], references: [id])
  holdbacks        Holdback[]

  @@index([repId])
  @@index([carrierId])
  @@index([status])
  @@map("chargebacks")
}

// ─── Manager / market-owner override earnings ───────────────────────────────

// The override slice of a commission, payable to the blitz's manager
// (MANAGER_OVERRIDE) or the market's owner (MARKET_OWNER_SPREAD). Mirrors the
// rep-commission lifecycle (ELIGIBLE→PENDING→PAID) so overrides flow through the
// same payout batches — but tracked separately so a manager can be paid
// independently of the rep. One row per (commission, role).
model OverrideEarning {
  id                 String           @id @default(cuid())
  commissionRecordId String           @map("commission_record_id")
  payeeId            String           @map("payee_id")
  role               OverrideRole
  amount             Float
  status             CommissionStatus @default(ELIGIBLE)
  payoutBatchId      String?          @map("payout_batch_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  commissionRecord CommissionRecord @relation(fields: [commissionRecordId], references: [id])
  payee            User             @relation(fields: [payeeId], references: [id])
  payoutBatch      PayoutBatch?     @relation(fields: [payoutBatchId], references: [id])

  @@unique([commissionRecordId, role])
  @@index([payeeId])
  @@index([status])
  @@index([payoutBatchId])
  @@map("override_earnings")
}

// ─── Custom per-rep commission overrides ────────────────────────────────────

// A flat per-install commission for a specific rep, optionally scoped to a
// product and/or carrier. When a matching override exists at calc time it
// replaces the rep's computed pay (the governance-tier multiplier is bypassed).
// Most-specific match wins: rep+product > rep+carrier > rep-global.
model RepCommissionOverride {
  id            String   @id @default(cuid())
  repId         String   @map("rep_id")
  carrierId     String?  @map("carrier_id")
  productId     String?  @map("product_id")
  amount        Float
  effectiveDate DateTime @map("effective_date")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  rep               User               @relation(fields: [repId], references: [id])
  carrier           Carrier?           @relation(fields: [carrierId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  commissionRecords CommissionRecord[]

  @@index([repId])
  @@index([active])
  @@index([effectiveDate])
  @@map("rep_commission_overrides")
}

// ─── Hierarchical rate sheets ───────────────────────────────────────────────

// A master-granted "available revenue" for a level in the pricing chain. An
// OWNER sheet grants a market owner the revenue they receive from the master;
// a MANAGER sheet grants a manager the revenue they receive from the owner.
// The commission slices (company floor / owner spread / manager override) are
// derived by subtraction down the chain when a sheet resolves for a sale.
model RateSheet {
  id               String         @id @default(cuid())
  level            RateSheetLevel
  principalId      String         @map("principal_id")
  carrierId        String?        @map("carrier_id")
  productId        String?        @map("product_id")
  availableRevenue Float          @map("available_revenue")
  effectiveDate    DateTime       @map("effective_date")
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  principal User     @relation(fields: [principalId], references: [id])
  carrier   Carrier? @relation(fields: [carrierId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])

  @@index([level])
  @@index([principalId])
  @@index([active])
  @@index([effectiveDate])
  @@map("rate_sheets")
}
