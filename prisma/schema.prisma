generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EXECUTIVE
  RECRUITER
  MARKET_OWNER
  FIELD_MANAGER
  TEAM_LEAD
  FIELD_REP
  CALL_CENTER
}

enum LeadSource {
  COLD
  SOCIAL
  REFERRAL
  PAID
}

enum LeadStatus {
  NEW
  SCREENING
  INTERVIEW
  APPROVED
  REJECTED
  ONBOARDED
}

enum InterviewResult {
  PENDING
  APPROVED
  REJECTED
}

enum BlitzStatus {
  PLANNING
  STAFFING
  READY
  ACTIVE
  REVIEW
  CLOSED
}

enum BlitzAssignmentStatus {
  ASSIGNED
  CONFIRMED
  IN_TRANSIT
  ACTIVE
  DEPARTED
  REMOVED
}

enum BlitzSignupStatus {
  CLAIMED // reserved a spot (under repCap), awaiting territory
  WAITLISTED // over repCap, in the queue
  ACTIVE // manager assigned territory → live on the blitz
  DECLINED // manager removed the claim
  WITHDRAWN // rep backed out
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
  SUSPENDED
  REJECTED
}

enum ExpenseCategory {
  HOUSING
  TRAVEL
  OPERATIONAL
  OTHER
}

enum GoBackStatus {
  SCHEDULED
  REVISITED
  CONVERTED
  CLOSED
}

enum SaleStatus {
  SUBMITTED
  PENDING_INSTALL
  INSTALLED
  VERIFIED
  CANCELLED
  DISPUTED
  CHARGEBACK
}

enum InstallRecordStatus {
  MATCHED
  UNMATCHED
  DISPUTED
}

enum CommissionStatus {
  ELIGIBLE
  PENDING
  ON_HOLD
  PAID
}

enum PayoutBatchStatus {
  DRAFT
  REVIEWED
  APPROVED
  PAID
}

enum StripeOnboardingStatus {
  NOT_STARTED
  PENDING
  ACTIVE
  RESTRICTED
}

enum TransferStatus {
  PENDING
  PAID
  FAILED
  REVERSED
}

enum HoldbackStatus {
  HELD
  RELEASED
  CLAWED_BACK
}

enum ChargebackStatus {
  OPEN
  RECOVERED
  WRITTEN_OFF
}

enum OverrideRole {
  MANAGER_OVERRIDE
  MARKET_OWNER_SPREAD
}

enum PayoutMethod {
  STANDARD
  INSTANT
}

enum RateSheetLevel {
  OWNER
  MANAGER
}

enum DeductionCategory {
  HOUSING
  TRAVEL
  SHARED
  REP_SPECIFIC
}

enum InboundLeadStatus {
  NEW
  CONTACTED
  SUBMITTED
  INSTALLED
  VERIFIED
}

enum InboundSaleStatus {
  SUBMITTED
  PENDING_INSTALL
  INSTALLED
  VERIFIED
  CANCELLED
}

enum DoorKnockDisposition {
  PENDING
  NOT_HOME
  GO_BACK
  SOLD
  NOT_INTERESTED
}

enum TouchpointOutcome {
  NO_ANSWER
  NOT_INTERESTED
  CALLBACK
  PITCHED
  SOLD
  DO_NOT_KNOCK
}

enum TouchpointType {
  DOOR_KNOCK
  CONTACT
  CONVERSATION
  DEMO
  CLOSE
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
}

enum MarketStatus {
  ACTIVE
  INACTIVE
  PLANNING
}

enum AgreementType {
  REP_AGREEMENT
  GPS_CONSENT
  TAX_W9
  BACKGROUND_CHECK
}

// ─── NextAuth Models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model GovernanceTier {
  id                   String   @id @default(cuid())
  name                 String
  rank                 Int
  minInstallRate       Float    @map("min_install_rate")
  commissionMultiplier Float    @default(1.0) @map("commission_multiplier")
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at")

  users             User[]
  governancePeriods GovernancePeriod[]
  commissionRecords CommissionRecord[]

  @@map("governance_tiers")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?   @map("password_hash")
  name             String?
  phone            String?
  role             Role
  status           UserStatus @default(ACTIVE)
  governanceTierId String?   @map("governance_tier_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Fiber Blitz OS v2 staffing/qualification fields (Sprint 1). All nullable.
  // CONTESTED (spec conflict #3): blitzReadinessScore + scoreBand compete with
  // the existing install-rate GovernanceTier — inert until Teki rules.
  carrierCredentials   Json?   @map("carrier_credentials")
  availabilityCalendar Json?   @map("availability_calendar")
  preferredMarkets     Json?   @map("preferred_markets")
  blitzReadinessScore  Float?  @map("blitz_readiness_score")
  scoreBand            String? @map("score_band")
  reliabilityHistory   Json?   @map("reliability_history")
  referralSource       String? @map("referral_source")
  onboardingData       Json?   @map("onboarding_data") // prospective-rep intake (status ONBOARDING)

  // Email verification
  emailVerified             Boolean   @default(false) @map("email_verified")
  emailVerificationToken    String?   @unique @map("email_verification_token")
  emailVerificationExpires  DateTime? @map("email_verification_expires")

  // Password reset
  passwordResetToken        String?   @unique @map("password_reset_token")
  passwordResetExpires      DateTime? @map("password_reset_expires")

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // GovernanceTier relation
  governanceTier GovernanceTier? @relation(fields: [governanceTierId], references: [id])

  // Recruiter side of leads
  recruitedLeads Lead[] @relation("RecruiterLeads")

  // Field manager side of leads
  managedLeads Lead[] @relation("FieldManagerLeads")

  // Leads where this user was created via onboarding
  onboardedLeads Lead[] @relation("OnboardedLeads")

  // Interviews conducted
  interviews Interview[]

  // Markets owned
  ownedMarkets Market[]

  // Blitzes managed
  managedBlitzes Blitz[]

  // Blitz assignments (as rep)
  blitzAssignments BlitzAssignment[]

  // Job-board signups (as rep)
  blitzSignups BlitzSignup[]

  // FBOS v2: targeted invites received (as rep) + gates this user escalates to
  // (as team lead / field manager).
  blitzInvites    BlitzInvite[]
  escalationGates CheckInGate[] @relation("GateEscalationTarget")
  penaltyWaivers  PenaltyWaiver[]

  // Daily reports
  dailyReports DailyReport[]

  // Go-backs recorded
  goBacksRecorded GoBack[]

  // Sales made
  sales Sale[]

  // Install uploads
  installUploads InstallUpload[]

  // Exceptions resolved
  resolvedExceptions InstallException[] @relation("ExceptionResolver")

  // Commission records
  commissionRecords CommissionRecord[]

  // Deductions
  deductions Deduction[]

  // Payout lines
  payoutLines PayoutLine[]

  // Approved payout batches
  approvedBatches PayoutBatch[] @relation("ApprovedBatches")

  // Payroll runs this user initiated (manager-initiated payroll)
  initiatedBatches PayoutBatch[] @relation("InitiatedBatches")

  // Override earnings (manager override / market-owner spread) payable to this user
  overrideEarnings OverrideEarning[]

  // Custom per-rep commission overrides
  repCommissionOverrides RepCommissionOverride[]

  // Hierarchical rate sheets granting this user (owner/manager) available revenue
  rateSheets RateSheet[]

  // Payout batch audit logs
  payoutBatchAuditLogs PayoutBatchAuditLog[]

  // Governance periods
  governancePeriods GovernancePeriod[]

  // Compliance holds
  complianceHolds ComplianceHold[] @relation("RepComplianceHolds")

  // Compliance holds restored by this user
  restoredComplianceHolds ComplianceHold[] @relation("ComplianceHoldRestorer")

  // Door knock leads assigned to this rep
  doorKnockLeads DoorKnockLead[] @relation("AssignedDoorKnockLeads")

  // Door knock leads uploaded by this user
  uploadedDoorKnockLeads DoorKnockLead[] @relation("UploadedDoorKnockLeads")

  // Inbound contact attempts (as agent)
  inboundContactAttempts InboundContactAttempt[]

  // Inbound sales (as agent)
  inboundSalesAsAgent InboundSale[] @relation("InboundSaleAgent")

  // Inbound sales (as affiliate)
  inboundSalesAsAffiliate InboundSale[] @relation("InboundSaleAffiliate")

  // GPS tracking sessions (rep clock-in/out for door-knock shifts)
  gpsSessions GpsSession[]
  timeLogEdits   GpsSessionEdit[] @relation("TimeLogEditRep")
  timeLogReviews GpsSessionEdit[] @relation("TimeLogEditReviewer")
  pushSubscriptions PushSubscription[]

  // Push notification tokens
  devicePushTokens DevicePushToken[]

  // Touchpoints logged by this rep
  touchpoints Touchpoint[]

  // Onboarding agreement acceptances
  agreementAcceptances AgreementAcceptance[]

  // Stripe Connect payout account (1:1)
  stripeAccount StripeConnectedAccount?

  // Stripe payout transfers received
  payoutTransfers PayoutTransfer[]

  // Commission holdbacks reserved for this rep
  holdbacks Holdback[]

  // Chargebacks against this rep's sales
  chargebacks Chargeback[] @relation("RepChargebacks")

  // Chargebacks this user recorded
  recordedChargebacks Chargeback[] @relation("ChargebackCreator")

  @@index([role])
  @@index([status])
  @@index([governanceTierId])
  @@index([scoreBand])
  @@map("users")
}

model GpsSession {
  id              String   @id @default(cuid())
  repId           String   @map("rep_id")
  // Exact blitz attribution for this session — supersedes the
  // date-overlap approximation in /api/rep/scorecard. Set by the
  // POST handler when the rep has exactly one ACTIVE blitz at
  // submission time; left null when ambiguous (0 or >1 ACTIVE).
  blitzId         String?  @map("blitz_id")
  startedAt       DateTime @map("started_at")
  endedAt         DateTime @map("ended_at")
  durationSeconds Int      @map("duration_seconds")
  pausedSeconds   Int      @default(0) @map("paused_seconds")
  knockCount      Int      @default(0) @map("knock_count")
  routeMiles      Float    @default(0) @map("route_miles")
  createdAt       DateTime @default(now()) @map("created_at")

  rep   User   @relation(fields: [repId], references: [id], onDelete: Cascade)
  blitz Blitz? @relation(fields: [blitzId], references: [id])
  edits GpsSessionEdit[]

  @@index([repId, startedAt])
  @@index([blitzId])
  @@map("gps_sessions")
}

enum TimeLogEditStatus {
  PENDING
  APPROVED
  REJECTED
}

// Rep-requested edit to a GpsSession time log. Requires manager approval before
// it's applied (Teki: "manager approval before editing"). The row persists
// after review as the audit trail — who requested what, who reviewed, when.
model GpsSessionEdit {
  id                    String    @id @default(cuid())
  sessionId             String    @map("session_id")
  repId                 String    @map("rep_id")
  // Proposed values; null means "leave that field unchanged" on apply.
  proposedStartedAt     DateTime? @map("proposed_started_at")
  proposedEndedAt       DateTime? @map("proposed_ended_at")
  proposedPausedSeconds Int?      @map("proposed_paused_seconds")
  proposedKnockCount    Int?      @map("proposed_knock_count")
  reason                String?
  status                TimeLogEditStatus @default(PENDING)
  reviewedById          String?   @map("reviewed_by_id")
  reviewedAt            DateTime? @map("reviewed_at")
  reviewNote            String?   @map("review_note")
  createdAt             DateTime  @default(now()) @map("created_at")

  session  GpsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rep      User       @relation("TimeLogEditRep", fields: [repId], references: [id])
  reviewer User?      @relation("TimeLogEditReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([sessionId])
  @@map("gps_session_edits")
}

model Lead {
  id               String     @id @default(cuid())
  name             String
  phone            String
  email            String?
  source           LeadSource
  status           LeadStatus @default(NEW)
  recruiterId      String     @map("recruiter_id")
  fieldManagerId   String?    @map("field_manager_id")
  marketId         String?    @map("market_id")
  onboardedUserId  String?    @map("onboarded_user_id")
  notes            String?
  travelCapable    Boolean    @map("travel_capable")
  commitmentLevel  String?    @map("commitment_level")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  recruiter      User    @relation("RecruiterLeads", fields: [recruiterId], references: [id])
  fieldManager   User?   @relation("FieldManagerLeads", fields: [fieldManagerId], references: [id])
  market         Market? @relation(fields: [marketId], references: [id])
  onboardedUser  User?   @relation("OnboardedLeads", fields: [onboardedUserId], references: [id])

  interviews Interview[]

  @@index([status])
  @@index([source])
  @@index([recruiterId])
  @@index([fieldManagerId])
  @@index([marketId])
  @@index([onboardedUserId])
  @@map("leads")
}

model Interview {
  id                     String          @id @default(cuid())
  leadId                 String          @map("lead_id")
  interviewerId          String          @map("interviewer_id")
  cultureFit             Int             @map("culture_fit")
  workEthic              Int             @map("work_ethic")
  travelReadiness        Int             @map("travel_readiness")
  performanceExpectations Int            @map("performance_expectations")
  notes                  String?
  result                 InterviewResult @default(PENDING)
  date                   DateTime
  createdAt              DateTime        @default(now()) @map("created_at")

  lead        Lead @relation(fields: [leadId], references: [id])
  interviewer User @relation(fields: [interviewerId], references: [id])

  @@index([leadId])
  @@index([interviewerId])
  @@index([result])
  @@map("interviews")
}

model Carrier {
  id               String        @id @default(cuid())
  name             String
  revenuePerInstall Float        @map("revenue_per_install")
  minMarginPercent Float         @default(0) @map("min_margin_percent")
  portalUrl        String?       @map("portal_url")
  status           CarrierStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at")

  markets        Market[]
  stackConfigs   StackConfig[]
  sales          Sale[]
  installUploads InstallUpload[]
  installRecords InstallRecord[]
  inboundSales   InboundSale[]
  holdbackPolicies HoldbackPolicy[]
  holdbacks      Holdback[]
  chargebacks    Chargeback[]
  products       Product[]
  repCommissionOverrides RepCommissionOverride[]
  rateSheets     RateSheet[]

  @@index([status])
  @@map("carriers")
}

// A carrier's product/plan catalog (e.g. 500 Mbps, 1 Gig). Each product has its
// own per-install revenue; a sale may reference one (else the carrier default is
// used). minMarginPercent overrides the carrier's for this product.
model Product {
  id               String   @id @default(cuid())
  carrierId        String   @map("carrier_id")
  name             String
  revenue          Float
  minMarginPercent Float?   @map("min_margin_percent")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  carrier           Carrier            @relation(fields: [carrierId], references: [id])
  sales             Sale[]
  stackConfigs      StackConfig[]
  commissionRecords CommissionRecord[]
  repCommissionOverrides RepCommissionOverride[]
  rateSheets        RateSheet[]

  @@index([carrierId])
  @@index([active])
  @@map("products")
}

model Market {
  id               String       @id @default(cuid())
  name             String
  carrierId        String       @map("carrier_id")
  ownerId          String       @map("owner_id")
  coverageArea     String?      @map("coverage_area")
  competitionNotes String?      @map("competition_notes")
  status           MarketStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")

  carrier Carrier @relation(fields: [carrierId], references: [id])
  owner   User    @relation(fields: [ownerId], references: [id])

  blitzes      Blitz[]
  leads        Lead[]
  stackConfigs StackConfig[]

  @@index([carrierId])
  @@index([ownerId])
  @@index([status])
  @@map("markets")
}

model Blitz {
  id          String      @id @default(cuid())
  marketId    String      @map("market_id")
  name        String
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  repCap      Int         @map("rep_cap")
  housingPlan String?     @map("housing_plan")
  status      BlitzStatus @default(PLANNING)
  managerId   String      @map("manager_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Lead-filtering pipeline state (area-created blitzes). PENDING -> FILTERING
  // -> READY. Defaults to READY so existing / non-area blitzes are never gated.
  // Staffing is hard-blocked until READY. Total/checked drive the list-view
  // progress bar; updatedAt powers staleness + ETA.
  leadPrepStatus    String    @default("READY") @map("lead_prep_status")
  leadPrepTotal     Int       @default(0) @map("lead_prep_total")
  leadPrepChecked   Int       @default(0) @map("lead_prep_checked")
  leadPrepUpdatedAt DateTime? @map("lead_prep_updated_at")
  // For deferred (background) address discovery: the ZIP to pull when a blitz
  // is created for an un-loaded ZIP, and where its addresses came from
  // ("openaddresses" = full, "osm" = partial fallback).
  leadPrepZip       String?   @map("lead_prep_zip")
  leadPrepSource    String?   @map("lead_prep_source")

  // Job board: when true, this blitz appears on the rep self-signup board.
  // Auto-set true once lead_prep reaches READY (so reps never claim an
  // unfiltered blitz). repCap caps claimed spots; overflow waitlists.
  openForSignup Boolean @default(false) @map("open_for_signup")
  // When a manager last broadcast this blitz to reps via push ("Notify reps").
  // Notifications are EXPLICIT/manual — opening for signup never auto-notifies,
  // so test blitzes don't spam reps. Null = never announced.
  boardNotifiedAt DateTime? @map("board_notified_at")
  // When this blitz first became claimable — anchors the premium 24h window.
  openedForSignupAt DateTime? @map("opened_for_signup_at")
  // When the manager finalized staffing ("Finish & notify reps"). Null = still a
  // draft: reps get NO check-in pings until this is set.
  staffingPublishedAt DateTime? @map("staffing_published_at")

  // Fiber Blitz OS v2 staffing spec (Sprint 1). All nullable/defaulted — added
  // ahead of the build, inert until the creation form + invite engine use them.
  slug                 String?  @unique
  compTierId           String?  @map("comp_tier_id")
  travelModel          String?  @map("travel_model")       // company_fronted | rep_fronted_reimburse
  travelCostCap        Int?     @map("travel_cost_cap")    // cents
  minScoreRequired     Int?     @map("min_score_required")
  qualificationFilters Json?    @map("qualification_filters")
  territoryPolygons    Json?    @map("territory_polygons") // GeoJSON
  dailyStartTime       String?  @map("daily_start_time")   // "HH:MM" local
  dailyEndTime         String?  @map("daily_end_time")
  timezone             String?
  repSeatsBackup       Int      @default(0) @map("rep_seats_backup")
  publicCardEnabled    Boolean  @default(false) @map("public_card_enabled")
  publicCardToken      String?  @unique @map("public_card_token")
  distributionMode     String   @default("both") @map("distribution_mode") // invites | board | both

  market   Market    @relation(fields: [marketId], references: [id])
  manager  User      @relation(fields: [managerId], references: [id])
  compTier CompTier? @relation(fields: [compTierId], references: [id])

  assignments   BlitzAssignment[]
  signups       BlitzSignup[]
  invites       BlitzInvite[]
  penaltyWaivers PenaltyWaiver[]
  expenses      BlitzExpense[]
  dailyReports  DailyReport[]
  goBacksRecorded GoBack[]
  sales         Sale[]
  deductions    Deduction[]
  commissionRecords CommissionRecord[]
  doorKnockLeads DoorKnockLead[]
  gpsSessions   GpsSession[]
  touchpoints    Touchpoint[]

  @@index([marketId])
  @@index([managerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([compTierId])
  @@map("blitzes")
}

model BlitzAssignment {
  id                  String                @id @default(cuid())
  blitzId             String                @map("blitz_id")
  repId               String                @map("rep_id")
  housingAssignment   String?               @map("housing_assignment")
  travelCoordination  String?               @map("travel_coordination")
  arrivalConfirmed    Boolean               @default(false) @map("arrival_confirmed")
  status              BlitzAssignmentStatus @default(ASSIGNED)
  createdAt           DateTime              @default(now()) @map("created_at")

  blitz Blitz @relation(fields: [blitzId], references: [id])
  rep   User  @relation(fields: [repId], references: [id])

  @@index([blitzId])
  @@index([repId])
  @@index([status])
  // Partial unique index: blitz_assignments_one_active_per_rep ON (rep_id) WHERE status NOT IN ('DEPARTED','REMOVED')
  // Added via raw SQL migration (Prisma does not support partial unique indexes in schema.prisma).
  @@map("blitz_assignments")
}

// Rep self-service job-board claim. Sits in front of BlitzAssignment: a rep
// claims a spot (CLAIMED if under repCap, else WAITLISTED); a manager then
// assigns territory, which flips the claim to ACTIVE and mirrors it into a
// BlitzAssignment so the rest of the app (counts, rep's blitz list) is
// unchanged. Withdraw/decline frees a spot and promotes the next waitlister.
model BlitzSignup {
  id           String            @id @default(cuid())
  blitzId      String            @map("blitz_id")
  repId        String            @map("rep_id")
  status       BlitzSignupStatus @default(CLAIMED)
  needsApproval Boolean          @default(false) @map("needs_approval") // restricted-band claim awaiting manager OK
  waitPosition Int?              @map("wait_position") // 1-based; set only when WAITLISTED
  claimedAt    DateTime          @default(now()) @map("claimed_at")
  activatedAt  DateTime?         @map("activated_at")
  decidedById  String?           @map("decided_by_id")
  decidedAt    DateTime?         @map("decided_at")

  blitz Blitz @relation(fields: [blitzId], references: [id], onDelete: Cascade)
  rep   User  @relation(fields: [repId], references: [id])

  // FBOS v2: a signup IS the spec's "BlitzSlot", so gates hang off it.
  gates           CheckInGate[]
  gateCompletions GateCompletion[]

  @@unique([blitzId, repId]) // one claim per rep per blitz
  @@index([blitzId, status])
  @@index([repId])
  @@map("blitz_signups")
}

// ── Fiber Blitz OS v2 staffing spec — Sprint 1 foundation models ──
// Stub tables; no app logic yet. Invites drive Sprint 2, gates Sprints 5-6.

enum BlitzInviteStatus {
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum GateStatus {
  PENDING
  SENT
  COMPLETED
  MISSED
  ESCALATED
}

// Preset comp library the create form selects from (spec §5.1).
model CompTier {
  id             String   @id @default(cuid())
  name           String
  baseCommission Int?     @map("base_commission") // cents
  bonusStructure Json?    @map("bonus_structure")
  travelNotes    String?  @map("travel_notes")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  blitzes Blitz[]

  @@map("comp_tiers")
}

// §4.3 — targeted push/SMS invitations + accept funnel.
model BlitzInvite {
  id            String            @id @default(cuid())
  blitzId       String            @map("blitz_id")
  repId         String            @map("rep_id")
  channel       String            @default("push") // push | sms | both
  status        BlitzInviteStatus @default(SENT)
  sentAt        DateTime          @default(now()) @map("sent_at")
  viewedAt      DateTime?         @map("viewed_at")
  acceptedAt    DateTime?         @map("accepted_at")
  declinedAt    DateTime?         @map("declined_at")
  expiresAt     DateTime?         @map("expires_at")
  timeToAccept  Int?              @map("time_to_accept") // seconds; feeds rep scoring

  blitz Blitz @relation(fields: [blitzId], references: [id], onDelete: Cascade)
  rep   User  @relation(fields: [repId], references: [id])

  @@unique([blitzId, repId])
  @@index([blitzId, status])
  @@index([repId])
  @@map("blitz_invites")
}

// §4.5 — scheduled check-in gate per slot (G0-G5). Slot = BlitzSignup.
model CheckInGate {
  id                   String     @id @default(cuid())
  blitzSlotId          String     @map("blitz_slot_id")
  gateId               String     @map("gate_id") // 'G0'..'G5'
  scheduledTriggerTime DateTime?  @map("scheduled_trigger_time")
  requiredActionType   String?    @map("required_action_type") // acknowledge|checklist|eta_submission|geofence|production_numbers
  payload              Json?
  status               GateStatus @default(PENDING)
  escalationTargetId   String?    @map("escalation_target_id")
  scoreImpact          Float      @default(0) @map("score_impact")
  nudges               Int        @default(0)
  lastNudgedAt         DateTime?  @map("last_nudged_at")
  createdAt            DateTime   @default(now()) @map("created_at")

  slot             BlitzSignup @relation(fields: [blitzSlotId], references: [id], onDelete: Cascade)
  escalationTarget User?       @relation("GateEscalationTarget", fields: [escalationTargetId], references: [id])

  @@unique([blitzSlotId, gateId])
  @@index([status, scheduledTriggerTime])
  @@map("check_in_gates")
}

// §4.4 — per-gate completion record feeding the readiness score.
model GateCompletion {
  id             String      @id @default(cuid())
  blitzSlotId    String      @map("blitz_slot_id")
  gateId         String      @map("gate_id") // 'G0'..'G5'
  completedAt    DateTime?   @map("completed_at")
  onFirstPush    Boolean?    @map("on_first_push")
  nudgesRequired Int         @default(0) @map("nudges_required")

  slot BlitzSignup @relation(fields: [blitzSlotId], references: [id], onDelete: Cascade)

  @@unique([blitzSlotId, gateId])
  @@map("gate_completions")
}

enum WaiverStatus {
