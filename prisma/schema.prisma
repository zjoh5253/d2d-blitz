// ─── Door Knock Leads ────────────────────────────────────────────────────────

model DoorKnockLead {
  id              String               @id @default(cuid())
  firstName       String?              @map("first_name")
  lastName        String?              @map("last_name")
  streetNumber    String               @map("street_number")
  streetName      String               @map("street_name")
  city            String
  state           String
  zip             String
  // Geographic coordinates — required by the rep-assignment planner to
  // build walkable territory clusters. Nullable because legacy / manual /
  // CSV-imported leads may not have them.
  lat             Float?
  lng             Float?
  // Coordinate provenance. When a rep dispositions a door, their phone GPS
  // (if a good fix) overwrites lat/lng in place — the rep standing at the
  // door is the most accurate source we have. coordSource records where the
  // current lat/lng came from ("rep_gps" once verified in the field, else the
  // import source) so a later bulk re-import never clobbers a rep-verified pin.
  coordSource     String?              @map("coord_source")
  coordsUpdatedAt DateTime?            @map("coords_updated_at")
  disposition     DoorKnockDisposition @default(PENDING)
  notes           String?
  assignedRepId   String?              @map("assigned_rep_id")
  blitzId         String?              @map("blitz_id")
  // Suppression: when a lead's address matches a known current customer
  // (existing install / sale / sold lead, or — later — a carrier partner
  // export), it's flagged so reps don't waste time knocking a door that
  // already has service. Hidden from reps; still visible to admins.
  suppressed        Boolean            @default(false)
  suppressionReason String?            @map("suppression_reason")
  goBackId        String?              @unique @map("go_back_id")
  uploadedById    String               @map("uploaded_by_id")
  uploadBatchId   String?              @map("upload_batch_id")
  resolvedAt      DateTime?            @map("resolved_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  assignedRep  User?   @relation("AssignedDoorKnockLeads", fields: [assignedRepId], references: [id])
  uploadedBy   User    @relation("UploadedDoorKnockLeads", fields: [uploadedById], references: [id])
  blitz        Blitz?  @relation(fields: [blitzId], references: [id])
  goBack       GoBack? @relation(fields: [goBackId], references: [id])
  events       DoorKnockLeadEvent[]

  @@index([assignedRepId])
  @@index([blitzId])
  @@index([disposition])
  @@index([uploadBatchId])
  @@index([uploadedById])
  @@index([suppressed])
  @@map("door_knock_leads")
}

// Per-lead action history — one row per disposition action so reps can
// re-open a pin and see what was done and when.
model DoorKnockLeadEvent {
  id          String               @id @default(cuid())
  leadId      String               @map("lead_id")
  disposition DoorKnockDisposition
  note        String?
  createdById String?              @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")

  lead DoorKnockLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("door_knock_lead_events")
}

// Cached per-address result of the Kinetic (gokinetic.com) availability
// check. Keyed by canonical address (canonicalizeAddress(street)|zip5) so a
// ZIP scanned for one blitz is reused by every other — the scan worker only
// hits gokinetic for addresses with no fresh row here. `isCustomer` drives
// lead suppression (reps don't knock current customers).
model KineticAddressStatus {
  id         String  @id @default(cuid())
  addressKey String  @unique @map("address_key")

  // Normalized signals
  serviceable Boolean @default(false)
  isCustomer  Boolean @default(false)
  comingSoon  Boolean @default(false)

  // Raw signals from the API, kept so we can re-derive the above if we
  // refine which field means "current customer".
  validationResult String? @map("validation_result")
  maxQual          String? @map("max_qual")
  techType         String? @map("tech_type")
  billingStatus    String? @map("billing_status")
  estCompletionDt  String? @map("est_completion_dt")
  raw              String?

  checkedAt DateTime @default(now()) @map("checked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isCustomer])
  @@index([serviceable])
  @@index([checkedAt])
  @@map("kinetic_address_status")
}

// Authoritative current-customer addresses from a carrier/partner export
// (e.g. Teki's Chuzo customer list). Keyed by canonical address so it feeds
// the suppression engine exactly like the in-DB sources. Re-importing an
// updated export just upserts.
model ServicedAddress {
  id         String   @id @default(cuid())
  addressKey String   @unique @map("address_key")
  source     String   // e.g. "chuzo-2026-06-04"
  rawAddress String?  @map("raw_address")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([source])
  @@map("serviced_addresses")
}
